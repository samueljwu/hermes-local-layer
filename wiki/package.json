{
  "name": "wiki",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "gen-sidebar": "node .vitepress/gen-sidebar.mjs",
    "gen-graph": "node .vitepress/gen-semantic-graph.mjs",
